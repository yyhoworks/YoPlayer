          <left>0</left>
          <top>0</top>
          <width>72</width>
          <height>72</height>
          <texture>infuse/glass_circle_dark.png</texture>
          <visible>[$PARAM[dark]] + !Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>72</width>
          <height>72</height>
          <texture>infuse/glass_circle_light.png</texture>
          <visible>![$PARAM[dark]] + !Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>72</width>
          <height>72</height>
          <texture>infuse/glass90/circle_white.png</texture>
          <visible>Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>18</left>
          <top>18</top>
          <width>36</width>
          <height>36</height>
          <texture colordiffuse="$PARAM[iconcolor]">$PARAM[icon]</texture>
          <visible>[$PARAM[dark]] + !Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>18</left>
          <top>18</top>
          <width>36</width>
          <height>36</height>
          <texture colordiffuse="infuse_ink_light">$PARAM[icon]</texture>
          <visible>Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>18</left>
          <top>18</top>
          <width>36</width>
          <height>36</height>
          <texture colordiffuse="infuse_ink_light">$PARAM[icon]</texture>
          <visible>![$PARAM[dark]] + !Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="button" id="$PARAM[id]">
          <left>0</left>
          <top>0</top>
          <width>72</width>
          <height>72</height>
          <texturefocus>-</texturefocus>
          <texturenofocus>-</texturenofocus>
          <onclick>$PARAM[onclick]</onclick>
          <onleft>$PARAM[onleft]</onleft>
          <onright>$PARAM[onright]</onright>
          <onup>$PARAM[onup]</onup>
          <onfocus>$PARAM[onfocus]</onfocus>
          <pulseonselect>false</pulseonselect>
          <label>$PARAM[accessible]</label>
          <textcolor>00000000</textcolor>
          <focusedcolor>00000000</focusedcolor>
          <disabledcolor>00000000</disabledcolor>
          <shadowcolor>00000000</shadowcolor>
          <ondown condition="String.IsEqual(Container.Property(YoPlayer.Browse.Empty),true)">533</ondown>
          <ondown condition="!String.IsEqual(Container.Property(YoPlayer.Browse.Empty),true)">$PARAM[ondown]</ondown>
          <onback condition="String.IsEqual(Container.Property(YoPlayer.Browse.Empty),true)">533</onback>
          <onback condition="!String.IsEqual(Container.Property(YoPlayer.Browse.Empty),true)">$PARAM[onback]</onback>
        </control>
      </control>
    </definition>
    <param name="accessible" default="" />
  </include>

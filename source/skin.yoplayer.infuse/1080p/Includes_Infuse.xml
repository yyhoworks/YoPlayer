  <include name="InfuseSectionHeader">
    <param name="label" default="" />
    <param name="left" default="90" />
    <param name="top" default="0" />
    <param name="width" default="1500" />
    <param name="dark" default="false" />
    <definition>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>48</height>
        <font>infuse_section</font>
        <textcolor>$VAR[YoPlayerUi_text]</textcolor>
        <label>$PARAM[label]</label>
        <align>left</align>
        <aligny>center</aligny>
        <visible>![$PARAM[dark]]</visible>
      </control>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>48</height>
        <font>infuse_section</font>
        <textcolor>$VAR[YoPlayerUi_text]</textcolor>
        <label>$PARAM[label]</label>
        <align>left</align>
        <aligny>center</aligny>
        <visible>[$PARAM[dark]]</visible>
      </control>
    </definition>
  </include>
  <include name="InfuseCardFace">
    <param name="mask" default="infuse/mask_landscape.png" />
    <param name="width" default="460" />
    <param name="height" default="260" />
    <param name="texture" default="$INFO[ListItem.Icon]" />
    <param name="title" default="$VAR[infoLabel]" />
    <param name="subtitle" default="" />
    <param name="dark" default="false" />
    <param name="unwatched" default="false" />
    <param name="showprogress" default="false" />
    <param name="shadowalpha" default="66FFFFFF" />
    <definition>
      <control type="group">
        <left>0</left>
        <top>0</top>
        <width>$PARAM[width]</width>
        <height>$PARAM[height]</height>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>$PARAM[height]</height>
          <texture border="48,48,48,48" colordiffuse="$PARAM[shadowalpha]">infuse/card_shadow.png</texture>
          <animation effect="zoom" start="112" end="112" center="auto" time="0" condition="true">Conditional</animation>
        </control>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>$PARAM[height]</height>
          <texture diffuse="$PARAM[mask]" fallback="infuse/poster_placeholder.png" background="true">$PARAM[texture]</texture>
          <aspectratio scalediffuse="false">scale</aspectratio>
        </control>
        <control type="image">
          <posx>32r</posx>
          <top>0</top>
          <width>32</width>
          <height>32</height>
          <texture colordiffuse="$VAR[YoPlayerUi_state]">infuse/theme-ui/badge_unwatched.png</texture>
          <visible>$PARAM[unwatched]</visible>
        </control>
        <control type="progress">
          <left>0</left>
          <posy>20r</posy>
          <width>$PARAM[width]</width>
          <height>8</height>
          <info>ListItem.PercentPlayed</info>
          <texturebg border="4,4,4,4" colordiffuse="$VAR[YoPlayerUi_line]">infuse/theme-ui/progress_track.png</texturebg>
          <midtexture border="4,4,4,4" colordiffuse="$VAR[YoPlayerUi_progress]">infuse/theme-ui/progress_fill_white.png</midtexture>
          <visible>[$PARAM[showprogress]] + Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
        </control>
      </control>
      <control type="group">
        <left>0</left>
        <top>$PARAM[height]</top>
        <width>$PARAM[width]</width>
        <height>96</height>
        <control type="label">
          <left>0</left>
          <top>12</top>
          <width>$PARAM[width]</width>
          <height>38</height>
          <font>infuse_card_title</font>
          <textcolor>$VAR[YoPlayerUi_text]</textcolor>
          <label>$PARAM[title]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>![$PARAM[dark]]</visible>
        </control>
        <control type="label">
          <left>0</left>
          <top>12</top>
          <width>$PARAM[width]</width>
          <height>38</height>
          <font>infuse_card_title</font>
          <textcolor>$VAR[YoPlayerUi_text]</textcolor>
          <label>$PARAM[title]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>[$PARAM[dark]]</visible>
        </control>
        <control type="label">
          <left>0</left>
          <top>52</top>
          <width>$PARAM[width]</width>
          <height>32</height>
          <font>infuse_card_sub</font>
          <textcolor>$VAR[YoPlayerUi_muted]</textcolor>
          <label>$PARAM[subtitle]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>![$PARAM[dark]]</visible>
        </control>
        <control type="label">
          <left>0</left>
          <top>52</top>
          <width>$PARAM[width]</width>
          <height>32</height>
          <font>infuse_card_sub</font>
          <textcolor>$VAR[YoPlayerUi_muted]</textcolor>
          <label>$PARAM[subtitle]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>[$PARAM[dark]]</visible>
        </control>
      </control>
    </definition>
  </include>
  <include name="InfuseLandscapeCard">
    <param name="mask" default="infuse/mask_landscape.png" />
    <param name="width" default="460" />
    <param name="height" default="260" />
    <param name="layoutheight" default="356" />
    <param name="texture" default="$INFO[ListItem.Art(fanart)]" />

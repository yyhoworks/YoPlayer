      <font>infuse_section</font>
      <textcolor>infuse_ink_dark</textcolor>
      <visible>String.IsEqual(Window(1143).Property(YoPlayer.ConfirmMode),stop)</visible>
    </control>
    <control type="grouplist" id="9000">
      <left>38</left>
      <top>293</top>
      <width>900</width>
      <height>60</height>
      <align>center</align>
      <itemgap>0</itemgap>
      <orientation>horizontal</orientation>
      <control type="button" id="11">
        <description>OK button</description>
        <width>300</width>
        <height>60</height>
        <label>107</label>
        <font>infuse_button</font>
        <textcolor>infuse_ink_dark</textcolor>
        <focusedcolor>FFF4F6F7</focusedcolor>
        <align>center</align>
        <onclick>SetProperty(ResetSkinSettings,True,Home)</onclick>
        <onclick>Skin.ResetSettings</onclick>
        <onclick>RunScript(special://skin/scripts/favfenku.py)</onclick>
        <onclick>ClearProperty(SkinInitStarted,Home)</onclick>
        <onclick>ReloadSkin()</onclick>
        <onclick>Skin.SetString(info_delay,0)</onclick>
        <onclick>Dialog.Close(1143)</onclick>
        <visible>String.IsEqual(Window(1143).Property(YoPlayer.ConfirmMode),reset)</visible>
        <disabledcolor>infuse_ink_dark2</disabledcolor>
        <textoffsetx>18</textoffsetx>
        <aligny>center</aligny>
        <scroll>true</scroll>
        <texturefocus border="24,24,24,24">infuse/graded/player-capsule.png</texturefocus>

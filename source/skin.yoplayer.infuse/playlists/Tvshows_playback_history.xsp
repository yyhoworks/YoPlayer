<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="tvshows">
    <name>剧集播放记录</name>
    <match>any</match>
    <rule field="playcount" operator="greaterthan">
        <value>0</value>
    </rule>
    <rule field="inprogress" operator="true" />
    <limit>100</limit>
    <order direction="descending">lastplayed</order>
</smartplaylist>

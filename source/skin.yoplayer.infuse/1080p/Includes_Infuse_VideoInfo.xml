<?xml version='1.0' encoding='utf-8'?>
<includes>
  <include name="InfuseCastCardLayout">
    <param name="avatar" default="$INFO[ListItem.Art(thumb)]" />
    <param name="name" default="$INFO[ListItem.Label]" />
    <param name="role" default="$INFO[ListItem.Label2]" />
    <definition>
      <control type="group">
        <width>200</width>
        <height>290</height>
        <animation effect="zoom" start="100" end="106" center="100,290" time="120" tween="sine" easing="out">Focus</animation>
        <animation effect="zoom" start="106" end="100" center="100,290" time="120" tween="sine" easing="out">UnFocus</animation>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>200</width>
          <height>200</height>
          <texture fallback="infuse/actor_placeholder.png" background="true" diffuse="infuse/mask_square.png">$PARAM[avatar]</texture>
          <aspectratio scalediffuse="false">scale</aspectratio>
        </control>
        <control type="label">
          <left>0</left>
          <top>212</top>
          <width>210</width>
          <height>30</height>
          <font>infuse_card_sub</font>
          <textcolor>infuse_ink_dark</textcolor>
          <shadowcolor>00000000</shadowcolor>
          <align>left</align>
          <scroll>false</scroll>
          <scrollout>false</scrollout>
          <label>$PARAM[name]</label>
        </control>
        <control type="label">
          <left>0</left>
          <top>242</top>
          <width>210</width>
          <height>44</height>
          <font>infuse_osd_hint</font>
          <textcolor>infuse_ink_dark2</textcolor>
          <shadowcolor>00000000</shadowcolor>
          <align>left</align>
          <scroll>false</scroll>
          <scrollout>false</scrollout>
          <label>$PARAM[role]</label>
        </control>
      </control>
    </definition>
  </include>
  <include name="InfuseDetailTmdbDirector">
    <control type="fixedlist" id="5050">
      <left>90</left>
      <top>68</top>
      <width>240</width>
      <height>300</height>
      <orientation>horizontal</orientation>
      <onclick>RunScript(special://skin/scripts/castphoto.py,director)</onclick>
      <scrolltime>200</scrolltime>
      <visible>System.AddonIsEnabled(plugin.video.themoviedb.helper) + System.HasAddon(plugin.video.themoviedb.helper) + !String.IsEqual(Window(movieinformation).Property(YoPlayer.Cast.directorimg),1)</visible>
      <visible>!String.Contains(ListItem.FolderPath,type=person) + !String.IsEqual(ListItem.DBTYPE,set)</visible>
      <itemlayout height="300" width="240">
        <include content="InfuseCastCardLayout">
          <param name="avatar" value="$INFO[ListItem.Art(thumb)]" />
          <param name="name" value="$INFO[ListItem.Label]" />
          <param name="role" value="$LOCALIZE[20339]" />
        </include>
      </itemlayout>
      <focusedlayout height="300" width="240">
        <include content="InfuseCastCardLayout">
          <param name="avatar" value="$INFO[ListItem.Art(thumb)]" />
          <param name="name" value="$INFO[ListItem.Label]" />
          <param name="role" value="$LOCALIZE[20339]" />
        </include>
      </focusedlayout>
      <content limit="1">$VAR[Path_FromDirector,plugin://plugin.video.themoviedb.helper/?info=details&amp;type=person]</content>
      <onright condition="Integer.IsGreater(Container(50).NumItems,0)">50</onright>
      <onright condition="!Integer.IsGreater(Container(50).NumItems,0) + Integer.IsGreater(Container(5051).NumItems,0)">5051</onright>
      <onright condition="Control.IsVisible(9050) + !Integer.IsGreater(Container(50).NumItems,0) + !Integer.IsGreater(Container(5051).NumItems,0)">9050</onright>
      <onright condition="Control.IsVisible(9060) + !Integer.IsGreater(Container(50).NumItems,0) + !Integer.IsGreater(Container(5051).NumItems,0)">9060</onright>
      <onup condition="ListItem.IsResumable + !Control.IsVisible(9060)">9004</onup>
      <onup condition="!ListItem.IsResumable + !Control.IsVisible(9060)">9001</onup>
      <onup condition="Control.IsVisible(9060)">9060</onup>
      <ondown condition="Control.IsVisible(9050)">9050</ondown>
    </control>
  </include>
  <include name="InfuseDetailTmdbCast">
    <control type="fixedlist" id="5051">
      <left>330</left>
      <top>68</top>
      <width>1500</width>
      <height>300</height>
      <orientation>horizontal</orientation>
      <onleft condition="System.AddonIsEnabled(plugin.video.themoviedb.helper) + System.HasAddon(plugin.video.themoviedb.helper) + !String.IsEqual(Window(movieinformation).Property(YoPlayer.Cast.directorimg),1)">5050</onleft>
      <onleft condition="!System.AddonIsEnabled(plugin.video.themoviedb.helper) | !System.HasAddon(plugin.video.themoviedb.helper) | Integer.IsEqual(Container(5050).NumItems,0) | String.IsEqual(Window(movieinformation).Property(YoPlayer.Cast.directorimg),1)">147</onleft>
      <scrolltime>200</scrolltime>
      <animation effect="slide" start="0,0" end="-240,0" time="0" condition="[!System.AddonIsEnabled(plugin.video.themoviedb.helper) | !System.HasAddon(plugin.video.themoviedb.helper) | String.IsEqual(Window(movieinformation).Property(YoPlayer.Cast.directorimg),1) | Integer.IsEqual(Container(5050).NumItems,0)] + [String.IsEmpty(ListItem.Director) + String.IsEmpty(Window(movieinformation).Property(YoPlayer.Cast.directorname))]">Conditional</animation>
      <visible>Integer.IsEqual(Container(50).NumItems,0)</visible>
      <visible>!String.Contains(ListItem.FolderPath,type=person) + !String.IsEqual(ListItem.DBTYPE,set)</visible>
      <itemlayout height="300" width="240">
        <include content="InfuseCastCardLayout" />
      </itemlayout>
      <focusedlayout height="300" width="240">
        <include content="InfuseCastCardLayout" />
      </focusedlayout>
      <content>$VAR[Path_info_Cast]</content>
      <onright>5051</onright>
      <onback condition="ListItem.IsResumable">9004</onback>
      <onback condition="!ListItem.IsResumable">9001</onback>
      <visible>System.AddonIsEnabled(plugin.video.themoviedb.helper) + Integer.IsGreater(Container(5051).NumItems,0)</visible>
      <onup condition="ListItem.IsResumable + !Control.IsVisible(9060)">9004</onup>
      <onup condition="!ListItem.IsResumable + !Control.IsVisible(9060)">9001</onup>
      <onup condition="Control.IsVisible(9060)">9060</onup>
      <ondown condition="Control.IsVisible(9050)">9050</ondown>
    </control>
  </include>

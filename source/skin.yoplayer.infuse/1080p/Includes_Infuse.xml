      <include content="YoPlayerBrowseLandscapeCard">
        <param name="focused" value="$PARAM[focused]" />
        <param name="ringwidth" value="$PARAM[ringwidth]" />
        <param name="ringheight" value="$PARAM[ringheight]" />
        <param name="width" value="$PARAM[width]" />
        <param name="height" value="$PARAM[height]" />
        <param name="layoutheight" value="$PARAM[layoutheight]" />
        <param name="texture" value="$PARAM[texture]" />
        <param name="title" value="$PARAM[title]" />
        <param name="subtitle" value="$PARAM[subtitle]" />
        <param name="showprogress" value="$PARAM[showprogress]" />
        <param name="dark" value="$PARAM[dark]" />
        <param name="unwatched" value="$PARAM[unwatched]" />
        <param name="shadowalpha" value="$PARAM[shadowalpha]" />
        <param name="mask" value="$PARAM[mask]" />
      </include>
    </definition>
  </include>
  <!-- Idle Home/library redraw only: constant 100% alpha, unchanged image and geometry. -->
  <include name="YoPlayerBrowseIdleBgRedraw">
  <control type="image">
    <left>0</left>
    <top>0</top>
    <width>1920</width>
    <height>1080</height>
    <texture>$VAR[YoPlayerThemeAssets]home_background.png</texture>
    <animation effect="fade" start="100" end="100" time="1000" reversible="false" condition="!Player.HasMedia + [Window.IsActive(10000) | Window.IsActive(10025)]">Conditional</animation>
  </control>
</include>

<?xml version='1.0' encoding='utf-8'?>
<includes>
  <include name="InfuseOSDTitle">
    <param name="left" default="90" />
    <param name="top" default="895" />
    <param name="width" default="1500" />
    <definition>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>82</height>
        <font>infuse_page_title</font>
        <textcolor>infuse_ink_dark</textcolor>
        <label>$INFO[VideoPlayer.TVShowTitle]$INFO[VideoPlayer.Season, · S]$INFO[VideoPlayer.Episode,E]</label>
        <shadowcolor>00000000</shadowcolor>
        <scroll>true</scroll>
        <visible>VideoPlayer.Content(episodes)</visible>
      </control>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>82</height>
        <font>infuse_page_title</font>
        <textcolor>infuse_ink_dark</textcolor>
        <label>$INFO[Player.Title]</label>
        <shadowcolor>00000000</shadowcolor>
        <scroll>true</scroll>
        <visible>!VideoPlayer.Content(episodes)</visible>
      </control>
    </definition>
  </include>
  <include name="InfuseProgressBar">
    <param name="left" default="90" />
    <param name="top" default="988" />
    <param name="width" default="1740" />
    <param name="info" default="Player.Progress" />
    <param name="height" default="4" />
    <param name="marktop" default="988" />
    <param name="markheight" default="4" />
    <param name="markcolor" default="CC0B0F12" />
    <param name="fillcolor" default="infuse_ink_dark" />
    <definition>
      <control type="progress">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>$PARAM[height]</height>
        <info>$PARAM[info]</info>
        <texturebg border="4,4,4,4">infuse/progress_track.png</texturebg>
        <midtexture colordiffuse="$PARAM[fillcolor]">colors/white.png</midtexture>
      </control>
      <control type="ranges" description="Chapter marks">
        <left>$PARAM[left]</left>
        <top>$PARAM[marktop]</top>
        <width>$PARAM[width]</width>
        <height>$PARAM[markheight]</height>
        <info>Player.Chapters</info>
        <texturebg colordiffuse="00FFFFFF">colors/white.png</texturebg>
        <lefttexture colordiffuse="$PARAM[markcolor]">colors/white.png</lefttexture>
        <visible>Integer.IsGreater(Player.ChapterCount,1)</visible>
      </control>
    </definition>
  </include>
  <include name="InfuseOSDTimes">
    <param name="left" default="90" />
    <param name="top" default="1008" />
    <param name="width" default="1740" />
    <definition>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>400</width>
        <height>52</height>
        <font>infuse_card_title</font>
        <textcolor>infuse_ink_dark</textcolor>
        <align>left</align>
        <label>$INFO[Player.Time]</label>
        <shadowcolor>00000000</shadowcolor>
        <visible>!Player.Seeking</visible>
      </control>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>400</width>
        <height>52</height>
        <font>infuse_card_title</font>
        <textcolor>infuse_ink_dark</textcolor>
        <align>left</align>
        <label>$INFO[Player.SeekTime]</label>
        <shadowcolor>00000000</shadowcolor>
        <visible>Player.Seeking</visible>
      </control>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>52</height>
        <font>infuse_card_title</font>
        <textcolor>infuse_ink_dark</textcolor>
        <align>right</align>
        <label>$INFO[Player.TimeRemaining,-]$INFO[Player.FinishTime(hh:mm),  ·  , 结束]</label>
        <shadowcolor>00000000</shadowcolor>
      </control>
    </definition>
  </include>
</includes>

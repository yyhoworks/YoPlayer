<?xml version='1.0' encoding='utf-8'?>
<includes>
  <include name="InfuseProgressBar">
    <param name="left" default="90" />
    <param name="top" default="988" />
    <param name="width" default="1740" />
    <param name="info" default="Player.Progress" />
    <definition>
      <control type="progress" description="A1: cache layer">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>10</height>
        <info>Player.ProgressCache</info>
        <texturebg border="5" colordiffuse="$VAR[YoPlayerOverlay_line_40]">infuse/theme-ui/plana/bar10.png</texturebg>
        <midtexture border="5" colordiffuse="$VAR[YoPlayerOverlay_progress_38]">infuse/theme-ui/plana/bar10.png</midtexture>
      </control>
      <control type="progress" description="A1: played">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>10</height>
        <info>$PARAM[info]</info>
        <texturebg border="5" colordiffuse="$VAR[YoPlayerOverlay_progress_00]">infuse/theme-ui/plana/bar10.png</texturebg>
        <midtexture border="5" colordiffuse="$VAR[YoPlayerOverlay_progress]">infuse/theme-ui/plana/bar10.png</midtexture>
      </control>
      <control type="ranges" description="A1: chapter marks">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>10</height>
        <info>Player.Chapters</info>
        <texturebg border="5" colordiffuse="$VAR[YoPlayerOverlay_progress_00]">infuse/theme-ui/plana/bar10.png</texturebg>
        <lefttexture colordiffuse="BF0B0F12">infuse/plana/mark10.png</lefttexture>
        <visible>Integer.IsGreater(Player.ChapterCount,1)</visible>
      </control>
    </definition>
  </include>
  <include name="YoPlayerOSDTagPill">
    <param name="label" />
    <param name="visible" default="true" />
    <definition>
      <control type="button">
        <width>auto</width>
        <height>38</height>
        <font>infuse_card_sub</font>
        <textcolor>$VAR[YoPlayerOverlay_text]</textcolor>
        <disabledcolor>$VAR[YoPlayerOverlay_disabled]</disabledcolor>
        <shadowcolor>00000000</shadowcolor>
        <textoffsetx>16</textoffsetx>
        <aligny>center</aligny>
        <texturenofocus border="19" colordiffuse="$VAR[YoPlayerOverlay_surface_73]">infuse/theme-ui/plana/pill-38.png</texturenofocus>
        <texturefocus border="19" colordiffuse="$VAR[YoPlayerOverlay_surface_73]">infuse/theme-ui/plana/pill-38.png</texturefocus>
        <label>$PARAM[label]</label>
        <enable>false</enable>
        <visible>$PARAM[visible]</visible>
      </control>
    </definition>
  </include>
  <include name="YoPlayerOSDTags">
    <param name="top" default="766" />
    <definition>
      <control type="grouplist" description="A1: playback tech tags">
        <left>120</left>
        <top>$PARAM[top]</top>
        <width>1160</width>
        <height>38</height>
        <orientation>horizontal</orientation>
        <itemgap>10</itemgap>
        <include content="YoPlayerOSDTagPill">
          <param name="label" value="$VAR[YoPlayerOSDResolution]" />
          <param name="visible" value="!String.IsEmpty(VideoPlayer.VideoResolution)" />
        </include>
        <include content="YoPlayerOSDTagPill">
          <param name="label" value="$VAR[YoPlayerOSDHdr]" />
          <param name="visible" value="String.IsEqual(VideoPlayer.HdrType,dolbyvision) | String.IsEqual(VideoPlayer.HdrType,hdr10) | String.IsEqual(VideoPlayer.HdrType,hdr10plus) | String.IsEqual(VideoPlayer.HdrType,hlg) | String.Contains(Player.Process(video.source.hdr.type),Vivid) | String.IsEqual(Player.Process(video.source.hdr.type.raw),1) | String.IsEqual(Player.Process(video.source.hdr.type.raw),2) | String.IsEqual(Player.Process(video.source.hdr.type.raw),3) | String.IsEqual(Player.Process(video.source.hdr.type.raw),4)" />
        </include>
        <include content="YoPlayerOSDTagPill">
          <param name="label" value="$VAR[YoPlayerOSDAudio]" />
          <param name="visible" value="!String.IsEmpty(VideoPlayer.AudioCodec)" />
        </include>
        <include content="YoPlayerOSDTagPill">
          <param name="label" value="$VAR[YoPlayerOSDSubtitle]" />
          <param name="visible" value="VideoPlayer.HasSubtitles + VideoPlayer.SubtitlesEnabled" />
        </include>
      </control>
    </definition>
  </include>
  <include name="InfusePlanATimes">
    <param name="left" default="120" />
    <param name="top" default="936" />
    <param name="width" default="1680" />
    <param name="chapterleft" default="540" />
    <param name="chapterwidth" default="840" />
    <definition>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>400</width>
        <height>52</height>
        <font>infuse_card_title</font>
        <textcolor>$VAR[YoPlayerOverlay_text]</textcolor>
        <align>left</align>
        <label>$INFO[Player.Time]</label>
        <shadowcolor>00000000</shadowcolor>
        <visible>!Player.Seeking</visible>
      </control>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>400</width>
        <height>52</height>
        <font>infuse_card_title</font>
        <textcolor>$VAR[YoPlayerOverlay_text]</textcolor>
        <align>left</align>
        <label>$INFO[Player.SeekTime]</label>
        <shadowcolor>00000000</shadowcolor>
        <visible>Player.Seeking</visible>
      </control>
      <control type="label" description="A1: chapter position and name">
        <left>$PARAM[chapterleft]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[chapterwidth]</width>
        <height>52</height>
        <font>infuse_card_sub</font>
        <textcolor>$VAR[YoPlayerOverlay_muted]</textcolor>
        <align>center</align>
        <aligny>center</aligny>
        <label>第 $VAR[YoPlayerOSDChapter] 章 / 共 $VAR[YoPlayerOSDChapterCount] 章$INFO[Player.ChapterName, · ]</label>
        <shadowcolor>00000000</shadowcolor>
        <visible>Integer.IsGreater(Player.ChapterCount,1)</visible>
      </control>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>52</height>
        <font>infuse_card_title</font>
        <textcolor>$VAR[YoPlayerOverlay_text]</textcolor>
        <align>right</align>
        <label>$INFO[Player.TimeRemaining,-]$INFO[Player.Duration,[COLOR=FFBAC2CA] / ,[/COLOR]]</label>
        <shadowcolor>00000000</shadowcolor>
      </control>
    </definition>
  </include>
</includes>

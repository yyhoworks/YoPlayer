<?xml version='1.0' encoding='utf-8'?>
<includes>
  <variable name="InfusePlayerInfoIconColor">
    <value condition="Control.HasFocus(2001)">FF1C1F26</value>
    <value>FFF2F2F2</value>
  </variable>
  <include name="InfusePlayerCircleBtn">
    <param name="selected" default="false" />
    <param name="id" />
    <param name="icon" />
    <param name="onclick" />
    <param name="label" default="" />
    <param name="visible" default="true" />
    <param name="enable" default="true" />
    <param name="onup" default="87" />
    <param name="ondown" default="ActivateWindow(playerprocessinfo)" />
    <definition>
      <control type="radiobutton" id="$PARAM[id]">
        <width>72</width>
        <height>72</height>
        <radiowidth>40</radiowidth>
        <radioheight>40</radioheight>
        <radioposx>16</radioposx>
        <radioposy>16</radioposy>
        <label>$PARAM[label]</label>
        <font />
        <texturefocus>infuse/glass_circle_light.png</texturefocus>
        <texturenofocus>infuse/glass_circle_dark.png</texturenofocus>
        <textureradioonfocus colordiffuse="FFF4F6F7">$PARAM[icon]</textureradioonfocus>
        <textureradioonnofocus colordiffuse="white">$PARAM[icon]</textureradioonnofocus>
        <textureradioofffocus colordiffuse="FFF4F6F7">$PARAM[icon]</textureradioofffocus>
        <textureradiooffnofocus colordiffuse="white">$PARAM[icon]</textureradiooffnofocus>
        <textureradioondisabled />
        <textureradiooffdisabled />
        <onclick>$PARAM[onclick]</onclick>
        <onup>$PARAM[onup]</onup>
        <ondown>$PARAM[ondown]</ondown>
        <visible>$PARAM[visible]</visible>
        <enable>$PARAM[enable]</enable>
        <selected>$PARAM[selected]</selected>
      </control>
    </definition>
  </include>
  <include name="InfuseOSDTitle">
    <param name="left" default="90" />
    <param name="top" default="895" />
    <param name="width" default="1500" />
    <definition>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>82</height>
        <font>infuse_page_title</font>
        <textcolor>infuse_ink_dark</textcolor>
        <label>$INFO[VideoPlayer.TVShowTitle]$INFO[VideoPlayer.Season, · S]$INFO[VideoPlayer.Episode,E]</label>
        <shadowcolor>00000000</shadowcolor>
        <scroll>true</scroll>
        <visible>VideoPlayer.Content(episodes)</visible>
      </control>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>82</height>
        <font>infuse_page_title</font>
        <textcolor>infuse_ink_dark</textcolor>
        <label>$INFO[Player.Title]</label>
        <shadowcolor>00000000</shadowcolor>
        <scroll>true</scroll>
        <visible>!VideoPlayer.Content(episodes)</visible>
      </control>
    </definition>
  </include>
  <include name="InfuseProgressBar">
    <param name="left" default="90" />
    <param name="top" default="988" />
    <param name="width" default="1740" />
    <param name="info" default="Player.Progress" />
    <definition>
      <control type="progress">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>4</height>
        <info>$PARAM[info]</info>
        <texturebg border="4,4,4,4">infuse/progress_track.png</texturebg>
        <midtexture colordiffuse="infuse_ink_dark">colors/white.png</midtexture>
      </control>
    </definition>
  </include>
  <include name="InfuseOSDTimes">
    <param name="left" default="90" />
    <param name="top" default="1008" />
    <param name="width" default="1740" />
    <definition>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>400</width>
        <height>52</height>
        <font>infuse_card_title</font>
        <textcolor>infuse_ink_dark</textcolor>
        <align>left</align>
        <label>$INFO[Player.Time]</label>
        <shadowcolor>00000000</shadowcolor>
        <visible>!Player.Seeking</visible>
      </control>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>400</width>
        <height>52</height>
        <font>infuse_card_title</font>
        <textcolor>infuse_ink_dark</textcolor>
        <align>left</align>
        <label>$INFO[Player.SeekTime]</label>
        <shadowcolor>00000000</shadowcolor>
        <visible>Player.Seeking</visible>
      </control>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>52</height>
        <font>infuse_card_title</font>
        <textcolor>infuse_ink_dark</textcolor>
        <align>right</align>
        <label>$INFO[Player.TimeRemaining,-]</label>
        <shadowcolor>00000000</shadowcolor>
      </control>
    </definition>
  </include>
</includes>

    <param name="unwatched" default="false" />
    <param name="showprogress" default="false" />
    <param name="shadowalpha" default="66FFFFFF" />
    <definition>
      <control type="group">
        <left>0</left>
        <top>0</top>
        <width>$PARAM[width]</width>
        <height>$PARAM[height]</height>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>$PARAM[height]</height>
          <texture border="48,48,48,48" colordiffuse="$PARAM[shadowalpha]">infuse/card_shadow.png</texture>
          <animation effect="zoom" start="112" end="112" center="auto" time="0" condition="true">Conditional</animation>
        </control>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>$PARAM[height]</height>
          <texture diffuse="$PARAM[mask]" fallback="infuse/poster_placeholder.png" background="true">$PARAM[texture]</texture>
          <aspectratio>keep</aspectratio>
        </control>
        <control type="image">
          <posx>32r</posx>
          <top>0</top>
          <width>32</width>
          <height>32</height>
          <texture>infuse/badge_unwatched.png</texture>
          <visible>$PARAM[unwatched]</visible>
        </control>
        <control type="progress">
          <left>0</left>
          <posy>20r</posy>
          <width>$PARAM[width]</width>
          <height>8</height>
          <info>ListItem.PercentPlayed</info>
          <texturebg border="4,4,4,4">infuse/progress_track.png</texturebg>
          <midtexture border="4,4,4,4">infuse/progress_fill.png</midtexture>
          <visible>[$PARAM[showprogress]] + Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
        </control>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>$PARAM[height]</height>
          <texture border="4">common/box21.png</texture>
          <visible>Skin.HasSetting(YoPlayer.BrowseCases) + Control.IsVisible(525) + !Container.Content(episodes)</visible>
        </control>
      </control>
      <control type="group">
        <left>0</left>
        <top>$PARAM[height]</top>
        <width>$PARAM[width]</width>
        <height>96</height>
        <control type="label">
          <left>0</left>
          <top>12</top>
          <width>$PARAM[width]</width>
          <height>38</height>
          <font>infuse_card_title</font>
          <textcolor>$VAR[YoPlayerTheme_text_infuseinklight]</textcolor>
          <label>$PARAM[title]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>![$PARAM[dark]]</visible>
        </control>
        <control type="label">
          <left>0</left>
          <top>12</top>
          <width>$PARAM[width]</width>
          <height>38</height>
          <font>infuse_card_title</font>
          <textcolor>infuse_ink_dark</textcolor>
          <label>$PARAM[title]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>[$PARAM[dark]]</visible>
        </control>
        <control type="label">

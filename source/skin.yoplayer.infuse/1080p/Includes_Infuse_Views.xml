        <visible>ListItem.IsParentFolder</visible>
        <animation effect="zoom" start="100" end="106" center="auto" time="120" tween="sine" easing="out">Focus</animation>
        <animation effect="zoom" start="106" end="100" center="auto" time="120" tween="sine" easing="out">UnFocus</animation>
        <control type="group">
          <width>$PARAM[width]</width>
          <height>$PARAM[height]</height>
          <control type="image">
            <width>$PARAM[width]</width>
            <height>$PARAM[height]</height>
            <texture diffuse="$PARAM[mask]" colordiffuse="66FFFFFF">colors/white.png</texture>
            <aspectratio>stretch</aspectratio>
          </control>
          <control type="image">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>64</width>
            <height>64</height>
            <texture colordiffuse="infuse_ink_light2">infuse/icons/back.png</texture>
            <aspectratio>keep</aspectratio>
          </control>
        </control>
        <control type="group">
          <top>$PARAM[height]</top>
          <width>$PARAM[width]</width>
          <height>96</height>
          <control type="label">
            <top>12</top>
            <width>$PARAM[width]</width>
            <height>38</height>
            <font>infuse_card_title</font>
            <textcolor>$VAR[YoPlayerTheme_text_infuseinklight]</textcolor>
            <align>center</align>
            <aligny>center</aligny>
            <label>$LOCALIZE[32154]</label>
          </control>
        </control>
      </control>
    </definition>
  </include>
  <variable name="InfuseNavPosterSub">

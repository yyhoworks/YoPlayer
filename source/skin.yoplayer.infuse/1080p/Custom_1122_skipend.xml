<?xml version='1.0' encoding='utf-8'?>
<window type="dialog" id="1122">
  <defaultcontrol always="true">11221</defaultcontrol>
  <onload>RunScript(special://skin/scripts/1122.py)</onload>
  <controls>
    <control type="group">
      <left>0</left>
      <top>650</top>
      <animation effect="slide" start="0,1080" end="0,800" time="200">WindowOpen</animation>
      <animation effect="slide" start="0,800" end="0,1080" time="200">WindowClose</animation>
      <depth>DepthSideBlade</depth>
      <control type="image">
        <left>0</left>
        <top>-550</top>
        <width>1920</width>
        <height>300</height>
        <texture border="32,32,32,32" colordiffuse="FFFFFFFF">infuse/glass_card_dark.png</texture>
      </control>
      <control type="image">
        <depth>DepthOSDPopout</depth>
        <left>20</left>
        <top>-540</top>
        <width>288</width>
        <height>162</height>
        <texture fallback="DefaultVideoCover.png">$INFO[Player.Icon]</texture>
        <aspectratio>stretch</aspectratio>
        <bordertexture infill="false" border="8">ThumbShadow.png</bordertexture>
        <bordersize>8</bordersize>
        <visible>String.IsEmpty(VideoPlayer.TvShowDBID)</visible>
      </control>
      <control type="label">
        <left>330</left>
        <top>-525</top>
        <width>1320</width>
        <label>发现本剧集的片尾标记为距离结束 [COLOR FFFFA500]$INFO[Skin.String(epend)][/COLOR]，是否直接跳至下一集？(3秒后自动执行)</label>
        <font>infuse_meta</font>
        <textcolor>infuse_ink_dark</textcolor>
        <height>30</height>
        <aligny>left</aligny>
        <visible>!Integer.IsEqual(Container(11220).NumItems,VideoPlayer.Episode) | String.IsEmpty(VideoPlayer.TvShowDBID)</visible>
        <scroll>true</scroll>
      </control>
      <control type="label">
        <left>330</left>
        <top>-525</top>
        <width>1320</width>
        <label>现在播放的是本剧集的最后一集，播放完毕后将自动返回列表！(3秒后自动执行)</label>
        <font>infuse_meta</font>
        <textcolor>infuse_ink_dark</textcolor>
        <height>30</height>
        <aligny>left</aligny>
        <visible>Integer.IsEqual(Container(11220).NumItems,VideoPlayer.Episode) + !String.IsEmpty(VideoPlayer.TvShowDBID)</visible>
        <scroll>true</scroll>
      </control>
      <control type="label">
        <left>330</left>
        <top>-480</top>
        <width>1200</width>
        <align>left</align>
        <font>infuse_meta</font>
        <label>$INFO[Container(11220).ListItem.TVShowTitle] $INFO[Container(11220).ListItem.Season, 第,季] $INFO[Container(11220).ListItem.Episode, 第,集]  $INFO[Container(11220).ListItem.Title]  $INFO[Container(11220).ListItem.Rating] $INFO[Container(11220).ListItem.Premiered, (,)]</label>
        <textcolor>infuse_ink_dark</textcolor>
        <shadowcolor>black</shadowcolor>
        <visible>!String.IsEmpty(VideoPlayer.TvShowDBID)</visible>
      </control>
      <control type="label">
        <left>330</left>
        <top>-480</top>
        <width>1200</width>
        <align>left</align>
        <font>infuse_meta</font>
        <label>$INFO[VideoPlayer.TVShowTitle] $INFO[VideoPlayer.Season, 第,季] $INFO[VideoPlayer.Episode, 第,集]  $INFO[Player.Title]  $INFO[VideoPlayer.Rating] $INFO[VideoPlayer.Premiered, (,)]</label>
        <textcolor>infuse_ink_dark</textcolor>
        <shadowcolor>black</shadowcolor>
        <visible>String.IsEmpty(VideoPlayer.TvShowDBID)</visible>
      </control>
      <control type="label">
        <description>Clock label</description>
        <left>675</left>
        <top>-525</top>
        <width>1200</width>
        <height>38</height>
        <align>right</align>
        <aligny>center</aligny>
        <font>infuse_meta</font>
        <textcolor>infuse_ink_dark</textcolor>
        <shadowcolor>black</shadowcolor>
        <label>$INFO[System.Time]</label>
      </control>
      <control type="label">
        <description>Clock label</description>
        <left>675</left>
        <top>-480</top>
        <width>1200</width>
        <height>38</height>
        <align>right</align>
        <aligny>center</aligny>
        <font>infuse_meta</font>
        <textcolor>infuse_ink_dark</textcolor>
        <shadowcolor>black</shadowcolor>
        <label>$INFO[Container(11220).ListItem.Duration(hh:mm), 将于, 结束]</label>
        <visible>!String.IsEmpty(VideoPlayer.TvShowDBID)</visible>
      </control>
      <control type="label">
        <description>Clock label</description>
        <left>675</left>
        <top>-480</top>
        <width>1200</width>
        <height>38</height>
        <align>right</align>
        <aligny>center</aligny>
        <font>infuse_meta</font>
        <textcolor>infuse_ink_dark</textcolor>
        <shadowcolor>black</shadowcolor>
        <label>$INFO[Player.FinishTime, 将于, 结束]</label>
        <visible>String.IsEmpty(VideoPlayer.TvShowDBID)</visible>
      </control>
      <control type="group">
        <control type="fixedlist" id="11220">
          <left>20</left>
          <top>-540</top>
          <width>300</width>
          <nested />
          <orientation>horizontal</orientation>
          <preloaditems>2</preloaditems>
          <scrolltime tween="quadratic">400</scrolltime>
          <visible>!String.IsEmpty(VideoPlayer.TvShowDBID)</visible>
          <itemlayout width="300" height="162">
            <control type="group">
              <nested />
              <width>288</width>
              <height>162</height>
              <control type="image">
                <aspectratio>stretch</aspectratio>
                <texture fallback="defaultvideocover.png">$VAR[Image_Landscape]</texture>
              </control>
            </control>
          </itemlayout>
          <focusedlayout width="300" height="162">
            <control type="group">
              <nested />
              <width>288</width>
              <height>162</height>
              <control type="image">
                <aspectratio>stretch</aspectratio>
                <texture fallback="defaultvideocover.png">$VAR[Image_Landscape]</texture>
              </control>
            </control>
          </focusedlayout>
          <content sortby="episode" sortorder="ascending">videodb://tvshows/titles/$INFO[VideoPlayer.TvShowDBID]/$INFO[VideoPlayer.Season]/?tvshowid=$INFO[VideoPlayer.TvShowDBID]</content>
        </control>
        <control type="grouplist">
          <left>330</left>
          <top>-435</top>
          <align>left</align>
          <itemgap>20</itemgap>
          <orientation>horizontal</orientation>
          <control type="button" id="11221">
            <width>200</width>
            <height>48</height>
            <font>infuse_meta</font>
            <align>center</align>
            <textcolor>infuse_ink_dark</textcolor>
            <focusedcolor>FFF4F6F7</focusedcolor>
            <label>立即跳转</label>
            <aspectratio>stretch</aspectratio>
            <include condition="!String.IsEmpty(Skin.String(customcolor)) + !String.IsEqual(Skin.String(customcolor),white)">homebuttonct</include>
            <include condition="String.IsEmpty(Skin.String(customcolor)) | String.IsEqual(Skin.String(customcolor),white)">homebuttondf</include>
            <texturenofocus border="24,24,24,24">infuse/graded/player-capsule.png</texturenofocus>
            <onclick condition="!Integer.IsEqual(Container(11220).NumItems,VideoPlayer.Episode) | String.IsEmpty(VideoPlayer.TvShowDBID)">RunScript(special://skin/scripts/tvjump.py,end)</onclick>
            <onclick condition="Integer.IsEqual(Container(11220).NumItems,VideoPlayer.Episode) + !String.IsEmpty(VideoPlayer.TvShowDBID)">PlayerControl(stop)</onclick>
            <onclick>Dialog.Close(1122)</onclick>
            <animation effect="zoom" start="70" end="100" time="200" tween="sine" easing="inout" center="auto">Focus</animation>
            <disabledcolor>infuse_ink_dark2</disabledcolor>
            <textoffsetx>18</textoffsetx>
            <aligny>center</aligny>
            <scroll>true</scroll>
            <texturefocus border="24,24,24,24">infuse/graded/player-capsule.png</texturefocus>
          </control>
          <control type="button" id="11222">
            <width>200</width>
            <height>48</height>
            <font>infuse_meta</font>
            <align>center</align>
            <textcolor>infuse_ink_dark</textcolor>
            <focusedcolor>FFF4F6F7</focusedcolor>
            <label>取  消</label>
            <aspectratio>stretch</aspectratio>
            <include condition="!String.IsEmpty(Skin.String(customcolor)) + !String.IsEqual(Skin.String(customcolor),white)">homebuttonct</include>
            <include condition="String.IsEmpty(Skin.String(customcolor)) | String.IsEqual(Skin.String(customcolor),white)">homebuttondf</include>
            <texturenofocus border="24,24,24,24">infuse/graded/player-capsule.png</texturenofocus>
            <onclick>Dialog.Close(1122)</onclick>
            <animation effect="zoom" start="70" end="100" time="200" tween="sine" easing="inout" center="auto">Focus</animation>
            <disabledcolor>infuse_ink_dark2</disabledcolor>
            <textoffsetx>18</textoffsetx>
            <aligny>center</aligny>
            <scroll>true</scroll>
            <texturefocus border="24,24,24,24">infuse/graded/player-capsule.png</texturefocus>
          </control>
        </control>
      </control>
    </control>
  </controls>
</window>

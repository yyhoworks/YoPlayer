          <visible>Window.IsActive(home) + [$PARAM[showprogress]] + !String.IsEmpty(ListItem.Property(YoPlayer.HomeRemaining))</visible>
          <control type="image"><left>0</left><top>0</top><width>202</width><height>42</height><texture border="16" colordiffuse="D9000000">infuse/plana/tog.png</texture></control>
          <control type="label"><left>8</left><top>0</top><width>186</width><height>42</height><font>infuse_card_sub</font><textcolor>FFF5F5F7</textcolor><align>center</align><aligny>center</aligny><label>$INFO[ListItem.Property(YoPlayer.HomeRemaining)]</label></control>
        </control>
        <control type="progress">
          <left>0</left>
          <posy>20r</posy>
          <width>$PARAM[width]</width>
          <height>8</height>
          <info>ListItem.PercentPlayed</info>
          <texturebg border="4,4,4,4" colordiffuse="$VAR[YoPlayerUi_line]">infuse/theme-ui/progress_track.png</texturebg>
          <midtexture border="4,4,4,4" colordiffuse="$VAR[YoPlayerUi_progress]">infuse/theme-ui/progress_fill_white.png</midtexture>
          <visible>[$PARAM[showprogress]] + Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
        </control>
      </control>
      <control type="group">
        <left>0</left>
        <top>$PARAM[height]</top>
        <width>$PARAM[width]</width>
        <height>96</height>
        <control type="label">
          <left>0</left>
          <top>12</top>
          <width>$PARAM[width]</width>
          <height>38</height>
          <font>infuse_card_title</font>
          <textcolor>$VAR[YoPlayerTheme_text_infuseinklight]</textcolor>
          <label>$PARAM[title]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>![$PARAM[dark]]</visible>
        </control>
        <control type="label">
          <left>0</left>
          <top>12</top>
          <width>$PARAM[width]</width>
          <height>38</height>
          <font>infuse_card_title</font>
          <textcolor>$VAR[YoPlayerUi_text]</textcolor>
          <label>$PARAM[title]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>[$PARAM[dark]]</visible>
        </control>
        <control type="label">
          <left>0</left>
          <top>52</top>
          <width>$PARAM[width]</width>
          <height>32</height>
          <font>infuse_card_sub</font>
          <textcolor>$VAR[YoPlayerTheme_secondary_infuseinklight2]</textcolor>
          <label>$PARAM[subtitle]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>![$PARAM[dark]]</visible>
        </control>
        <control type="label">
          <left>0</left>
          <top>52</top>
          <width>$PARAM[width]</width>
          <height>32</height>
          <font>infuse_card_sub</font>
          <textcolor>$VAR[YoPlayerUi_muted]</textcolor>
          <label>$PARAM[subtitle]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>[$PARAM[dark]]</visible>
        </control>
      </control>
    </definition>
  </include>
  <include name="YoPlayerBrowseLandscapeCard">
    <param name="mask" default="infuse/mask_landscape.png" />
    <param name="width" default="460" />
    <param name="height" default="260" />
    <param name="layoutheight" default="356" />
    <param name="texture" default="$INFO[ListItem.Art(fanart)]" />
    <param name="title" default="$VAR[infoLabel]" />
    <param name="subtitle" default="" />
    <param name="showprogress" default="true" />
    <param name="dark" default="false" />
    <param name="unwatched" default="false" />
    <param name="shadowalpha" default="66FFFFFF" />
    <param name="focused" default="false" />
    <param name="ringwidth" default="476" />
    <param name="ringheight" default="276" />
    <definition>
      <control type="group">
        <left>0</left>
        <top>0</top>
        <width>$PARAM[width]</width>
        <height>$PARAM[layoutheight]</height>
        <animation effect="zoom" start="100" end="106" center="auto" time="120" tween="sine" easing="out">Focus</animation>
        <animation effect="zoom" start="106" end="100" center="auto" time="120" tween="sine" easing="out">UnFocus</animation>
        <include content="YoPlayerBrowseCardFace">
          <param name="width" value="$PARAM[width]" />
          <param name="height" value="$PARAM[height]" />
          <param name="texture" value="$PARAM[texture]" />
          <param name="title" value="$PARAM[title]" />
          <param name="subtitle" value="$PARAM[subtitle]" />
          <param name="dark" value="$PARAM[dark]" />
          <param name="unwatched" value="$PARAM[unwatched]" />
          <param name="showprogress" value="$PARAM[showprogress]" />
          <param name="shadowalpha" value="$PARAM[shadowalpha]" />
          <param name="mask" value="$PARAM[mask]" />
        </include>
        <include content="YoPlayerCardFocusRing">
          <param name="ringwidth" value="$PARAM[ringwidth]" />
          <param name="ringheight" value="$PARAM[ringheight]" />
          <param name="focused" value="$PARAM[focused]" />
        </include>
      </control>
    </definition>
  </include>
  <!-- UI4: themed ring around the focused card; only while its row has focus.
       ringwidth/ringheight are the card size + 16 (8 px outside each edge). -->
  <include name="YoPlayerCardFocusRing">
    <param name="ringwidth" default="476" />
    <param name="ringheight" default="276" />
    <param name="focused" default="false" />
    <definition>
      <control type="image">
        <left>-8</left>
        <top>-8</top>
        <width>$PARAM[ringwidth]</width>
        <height>$PARAM[ringheight]</height>
        <texture border="32" colordiffuse="$VAR[YoPlayerUi_focus]">infuse/theme-ui/home/focus-ring.png</texture>
        <visible>[$PARAM[focused]]</visible>
      </control>
    </definition>
  </include>
  <include name="YoPlayerBrowsePosterCard">
    <param name="mask" default="infuse/mask_portrait.png" />
    <param name="width" default="300" />
    <param name="height" default="450" />
    <param name="layoutheight" default="546" />
    <param name="texture" default="$INFO[ListItem.Art(poster)]" />
    <param name="title" default="$VAR[infoLabel]" />
    <param name="subtitle" default="$INFO[ListItem.Year]" />
    <param name="showprogress" default="false" />
    <param name="dark" default="false" />
    <param name="unwatched" default="false" />
    <param name="shadowalpha" default="66FFFFFF" />
    <param name="focused" default="false" />
    <param name="ringwidth" default="316" />
    <param name="ringheight" default="466" />

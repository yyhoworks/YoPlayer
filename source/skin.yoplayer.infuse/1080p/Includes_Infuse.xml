      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="$VAR[YoPlayerUi_bg]">infuse/theme-ui/home_background.png</texture>
    </control>
  </include>
  <include name="InfusePageBgDark">
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="$VAR[YoPlayerUi_bg]">colors/white.png</texture>

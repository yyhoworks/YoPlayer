          <param name="width" value="$PARAM[width]" />
          <param name="height" value="$PARAM[height]" />
          <param name="texture" value="$PARAM[texture]" />
          <param name="title" value="$PARAM[title]" />
          <param name="subtitle" value="$PARAM[subtitle]" />
          <param name="dark" value="$PARAM[dark]" />
          <param name="unwatched" value="$PARAM[unwatched]" />
          <param name="showprogress" value="$PARAM[showprogress]" />
          <param name="shadowalpha" value="$PARAM[shadowalpha]" />
          <param name="mask" value="$PARAM[mask]" />
        </include>
      </control>
    </definition>
  </include>

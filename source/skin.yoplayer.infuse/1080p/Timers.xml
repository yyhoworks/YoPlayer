    <stop>!Window.IsActive(1116) | String.IsEmpty(Skin.String(OSDAutoCloseTime)) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(1116autoclose), 4) | !String.IsEmpty(Skin.String(OSDAutoCloseTime)) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(1116autoclose),Skin.Numeric(OSDAutoCloseTime))</stop>

<?xml version='1.0' encoding='utf-8'?>
<includes>
  <include name="InfusePageBgLight">
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture>infuse/home_background.png</texture>
    </control>
  </include>
  <include name="InfusePageBgDark">
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="infuse_bg_dark">colors/white.png</texture>
    </control>
  </include>
  <include name="InfuseSectionHeader">
    <param name="label" default="" />
    <param name="left" default="90" />
    <param name="top" default="0" />
    <param name="width" default="1500" />
    <param name="dark" default="false" />
    <definition>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>48</height>
        <font>infuse_section</font>
        <textcolor>infuse_ink_light</textcolor>
        <label>$PARAM[label]</label>
        <align>left</align>
        <aligny>center</aligny>
        <visible>![$PARAM[dark]]</visible>
      </control>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>48</height>
        <font>infuse_section</font>
        <textcolor>infuse_ink_dark</textcolor>
        <label>$PARAM[label]</label>
        <align>left</align>
        <aligny>center</aligny>
        <visible>[$PARAM[dark]]</visible>
      </control>
    </definition>
  </include>
  <include name="InfuseCardFace">
    <param name="mask" default="infuse/mask_landscape.png" />
    <param name="width" default="460" />
    <param name="height" default="260" />
    <param name="texture" default="$INFO[ListItem.Icon]" />
    <param name="title" default="$VAR[infoLabel]" />
    <param name="subtitle" default="" />
    <param name="dark" default="false" />
    <param name="unwatched" default="false" />
    <param name="showprogress" default="false" />
    <param name="shadowalpha" default="66FFFFFF" />
    <definition>
      <control type="group">
        <left>0</left>
        <top>0</top>
        <width>$PARAM[width]</width>
        <height>$PARAM[height]</height>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>$PARAM[height]</height>
          <texture border="48,48,48,48" colordiffuse="$PARAM[shadowalpha]">infuse/card_shadow.png</texture>
          <animation effect="zoom" start="112" end="112" center="auto" time="0" condition="true">Conditional</animation>
        </control>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>$PARAM[height]</height>
          <texture diffuse="$PARAM[mask]" fallback="infuse/poster_placeholder.png" background="true">$PARAM[texture]</texture>
          <aspectratio scalediffuse="false">scale</aspectratio>
        </control>
        <control type="image">
          <posx>32r</posx>
          <top>0</top>
          <width>32</width>
          <height>32</height>
          <texture>infuse/badge_unwatched.png</texture>
          <visible>$PARAM[unwatched]</visible>
        </control>
        <control type="progress">
          <left>0</left>
          <posy>20r</posy>
          <width>$PARAM[width]</width>
          <height>8</height>
          <info>ListItem.PercentPlayed</info>
          <texturebg border="4,4,4,4">infuse/progress_track.png</texturebg>
          <midtexture border="4,4,4,4">infuse/progress_fill.png</midtexture>
          <visible>[$PARAM[showprogress]] + Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
        </control>
      </control>
      <control type="group">
        <left>0</left>
        <top>$PARAM[height]</top>
        <width>$PARAM[width]</width>
        <height>96</height>
        <control type="label">
          <left>0</left>
          <top>12</top>
          <width>$PARAM[width]</width>
          <height>38</height>
          <font>infuse_card_title</font>
          <textcolor>infuse_ink_light</textcolor>
          <label>$PARAM[title]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>![$PARAM[dark]]</visible>
        </control>
        <control type="label">
          <left>0</left>
          <top>12</top>
          <width>$PARAM[width]</width>
          <height>38</height>
          <font>infuse_card_title</font>
          <textcolor>infuse_ink_dark</textcolor>
          <label>$PARAM[title]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>[$PARAM[dark]]</visible>
        </control>
        <control type="label">
          <left>0</left>
          <top>52</top>
          <width>$PARAM[width]</width>
          <height>32</height>
          <font>infuse_card_sub</font>
          <textcolor>infuse_ink_light2</textcolor>
          <label>$PARAM[subtitle]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>![$PARAM[dark]]</visible>
        </control>
        <control type="label">
          <left>0</left>
          <top>52</top>
          <width>$PARAM[width]</width>
          <height>32</height>
          <font>infuse_card_sub</font>
          <textcolor>infuse_ink_dark2</textcolor>
          <label>$PARAM[subtitle]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>[$PARAM[dark]]</visible>
        </control>
      </control>
    </definition>
  </include>
  <include name="InfuseLandscapeCard">
    <param name="mask" default="infuse/mask_landscape.png" />
    <param name="width" default="460" />
    <param name="height" default="260" />
    <param name="layoutheight" default="356" />
    <param name="texture" default="$INFO[ListItem.Art(fanart)]" />
    <param name="title" default="$VAR[infoLabel]" />
    <param name="subtitle" default="" />
    <param name="showprogress" default="true" />
    <param name="dark" default="false" />
    <param name="unwatched" default="false" />
    <param name="shadowalpha" default="66FFFFFF" />
    <definition>
      <control type="group">
        <left>0</left>
        <top>0</top>
        <width>$PARAM[width]</width>
        <height>$PARAM[layoutheight]</height>
        <animation effect="zoom" start="100" end="106" center="auto" time="120" tween="sine" easing="out">Focus</animation>
        <animation effect="zoom" start="106" end="100" center="auto" time="120" tween="sine" easing="out">UnFocus</animation>
        <include content="InfuseCardFace">
          <param name="width" value="$PARAM[width]" />
          <param name="height" value="$PARAM[height]" />
          <param name="texture" value="$PARAM[texture]" />
          <param name="title" value="$PARAM[title]" />
          <param name="subtitle" value="$PARAM[subtitle]" />
          <param name="dark" value="$PARAM[dark]" />
          <param name="unwatched" value="$PARAM[unwatched]" />
          <param name="showprogress" value="$PARAM[showprogress]" />
          <param name="shadowalpha" value="$PARAM[shadowalpha]" />
          <param name="mask" value="$PARAM[mask]" />
        </include>
      </control>
    </definition>
  </include>
  <include name="InfusePosterCard">
    <param name="mask" default="infuse/mask_portrait.png" />
    <param name="width" default="300" />
    <param name="height" default="450" />
    <param name="layoutheight" default="546" />
    <param name="texture" default="$INFO[ListItem.Art(poster)]" />
    <param name="title" default="$VAR[infoLabel]" />
    <param name="subtitle" default="$INFO[ListItem.Year]" />
    <param name="showprogress" default="false" />
    <param name="dark" default="false" />
    <param name="unwatched" default="false" />
    <param name="shadowalpha" default="66FFFFFF" />
    <definition>
      <include content="InfuseLandscapeCard">
        <param name="width" value="$PARAM[width]" />
        <param name="height" value="$PARAM[height]" />
        <param name="layoutheight" value="$PARAM[layoutheight]" />
        <param name="texture" value="$PARAM[texture]" />
        <param name="title" value="$PARAM[title]" />
        <param name="subtitle" value="$PARAM[subtitle]" />
        <param name="showprogress" value="$PARAM[showprogress]" />
        <param name="dark" value="$PARAM[dark]" />
        <param name="unwatched" value="$PARAM[unwatched]" />
        <param name="shadowalpha" value="$PARAM[shadowalpha]" />
        <param name="mask" value="$PARAM[mask]" />
      </include>
    </definition>
  </include>
  <include name="InfuseEpisodeCard">
    <param name="mask" default="infuse/mask_landscape.png" />
    <param name="width" default="460" />
    <param name="height" default="260" />
    <param name="layoutheight" default="356" />
    <param name="texture" default="$INFO[ListItem.Icon]" />
    <param name="title" default="$VAR[infoLabel]" />
    <param name="subtitle" default="" />
    <param name="showprogress" default="true" />
    <param name="dark" default="false" />
    <param name="unwatched" default="String.IsEqual(ListItem.PlayCount,0)" />
    <param name="shadowalpha" default="66FFFFFF" />
    <definition>
      <include content="InfuseLandscapeCard">
        <param name="width" value="$PARAM[width]" />
        <param name="height" value="$PARAM[height]" />
        <param name="layoutheight" value="$PARAM[layoutheight]" />
        <param name="texture" value="$PARAM[texture]" />
        <param name="title" value="$PARAM[title]" />
        <param name="subtitle" value="$PARAM[subtitle]" />
        <param name="showprogress" value="$PARAM[showprogress]" />
        <param name="dark" value="$PARAM[dark]" />
        <param name="unwatched" value="$PARAM[unwatched]" />
        <param name="shadowalpha" value="$PARAM[shadowalpha]" />
        <param name="mask" value="$PARAM[mask]" />
      </include>
    </definition>
  </include>
  <include name="InfuseGlassButton">
    <param name="id" default="0" />
    <param name="left" default="0" />
    <param name="top" default="0" />
    <param name="width" default="360" />
    <param name="label" default="" />
    <param name="icon" default="" />
    <param name="dark" default="true" />
    <param name="onclick" default="" />
    <param name="onleft" default="" />
    <param name="onright" default="" />
    <param name="onup" default="" />
    <param name="ondown" default="" />
    <param name="onback" default="" />
    <param name="onfocus" default="" />
    <param name="onclick2" default="" />
    <definition>
      <control type="group">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>72</height>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>72</height>
          <texture border="36,36,36,36">infuse/glass_capsule_dark.png</texture>
          <visible>[$PARAM[dark]] + !Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>72</height>
          <texture border="36,36,36,36">infuse/glass_capsule_light.png</texture>
          <visible>![$PARAM[dark]] + !Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>72</height>
          <texture border="36,36,36,36">infuse/glass90/capsule_white.png</texture>
          <visible>Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>20</left>
          <top>20</top>
          <width>32</width>
          <height>32</height>
          <texture>$PARAM[icon]</texture>
          <visible>[$PARAM[dark]] + !Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>20</left>
          <top>20</top>
          <width>32</width>
          <height>32</height>
          <texture colordiffuse="infuse_ink_light">$PARAM[icon]</texture>
          <visible>Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="image">
          <left>20</left>
          <top>20</top>
          <width>32</width>
          <height>32</height>
          <texture colordiffuse="infuse_ink_light">$PARAM[icon]</texture>
          <visible>![$PARAM[dark]] + !Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="label">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>72</height>
          <font>infuse_button</font>
          <textcolor>FFF4F6F7</textcolor>
          <label>$PARAM[label]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>[$PARAM[dark]] + !Control.HasFocus($PARAM[id])</visible>
          <shadowcolor>B3000000</shadowcolor>
        </control>
        <control type="label">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>72</height>
          <font>infuse_button</font>
          <textcolor>infuse_ink_light</textcolor>
          <label>$PARAM[label]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>![$PARAM[dark]] + !Control.HasFocus($PARAM[id])</visible>
          <shadowcolor>00000000</shadowcolor>
        </control>
        <control type="label">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>72</height>
          <font>infuse_button</font>
          <textcolor>infuse_ink_light</textcolor>
          <label>$PARAM[label]</label>
          <align>center</align>
          <aligny>center</aligny>
          <visible>Control.HasFocus($PARAM[id])</visible>
          <shadowcolor>00000000</shadowcolor>
        </control>
        <control type="button" id="$PARAM[id]">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>72</height>
          <texturefocus>-</texturefocus>
          <texturenofocus>-</texturenofocus>
          <onclick>$PARAM[onclick]</onclick>
          <onclick>$PARAM[onclick2]</onclick>
          <onleft>$PARAM[onleft]</onleft>
          <onright>$PARAM[onright]</onright>
          <onup>$PARAM[onup]</onup>
          <ondown>$PARAM[ondown]</ondown>
          <onback>$PARAM[onback]</onback>
          <onfocus>$PARAM[onfocus]</onfocus>
          <label />
          <pulseonselect>false</pulseonselect>
        </control>
      </control>
    </definition>
  </include>

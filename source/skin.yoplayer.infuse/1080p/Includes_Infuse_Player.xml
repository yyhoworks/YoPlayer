<?xml version='1.0' encoding='utf-8'?>
<includes>
  <include name="InfuseProgressBar">
    <param name="left" default="90" />
    <param name="top" default="988" />
    <param name="width" default="1740" />
    <param name="info" default="Player.Progress" />
    <definition>
      <control type="progress">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>4</height>
        <info>$PARAM[info]</info>
        <texturebg border="4,4,4,4">infuse/progress_track.png</texturebg>
        <midtexture colordiffuse="infuse_ink_dark">colors/white.png</midtexture>
      </control>
    </definition>
  </include>
  <include name="InfusePlanATimes">
    <param name="left" default="120" />
    <param name="top" default="936" />
    <param name="width" default="1680" />
    <definition>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>400</width>
        <height>52</height>
        <font>infuse_card_title</font>
        <textcolor>FFF4F6F7</textcolor>
        <align>left</align>
        <label>$INFO[Player.Time]</label>
        <shadowcolor>00000000</shadowcolor>
        <visible>!Player.Seeking</visible>
      </control>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>400</width>
        <height>52</height>
        <font>infuse_card_title</font>
        <textcolor>FFF4F6F7</textcolor>
        <align>left</align>
        <label>$INFO[Player.SeekTime]</label>
        <shadowcolor>00000000</shadowcolor>
        <visible>Player.Seeking</visible>
      </control>
      <control type="label">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>52</height>
        <font>infuse_card_title</font>
        <textcolor>FFBAC2CA</textcolor>
        <align>right</align>
        <label>$INFO[Player.TimeRemaining,-]</label>
        <shadowcolor>00000000</shadowcolor>
      </control>
    </definition>
  </include>
</includes>

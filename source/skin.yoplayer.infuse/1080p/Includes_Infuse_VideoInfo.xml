  <include name="YoPlayerDetailMetaLine">
    <param name="item" default="ListItem" />
    <param name="namespace" default="YoPlayerDetailItem" />
    <param name="visible" default="True" />
    <definition>
      <control type="grouplist">
        <left>820</left>
        <top>236</top>
        <width>1010</width>
        <height>48</height>
        <orientation>horizontal</orientation>
        <itemgap>16</itemgap>
        <align>left</align>
        <usecontrolcoords>true</usecontrolcoords>
        <visible>$PARAM[visible]</visible>
        <control type="image">
          <top>13</top>
          <width>22</width>
          <height>22</height>
          <texture>infuse/icons/star_fill.png</texture>
          <visible>[!String.IsEmpty($PARAM[item].Rating) + !String.IsEqual($PARAM[item].Rating,0) + !String.IsEqual($PARAM[item].Rating,0.0)] + ![!Skin.HasSetting(YoPlayerHideRating) + !String.IsEmpty(Window.Property(YoPlayer.Rating)) + !String.Contains(ListItem.FolderPath,type=person)]</visible>
        </control>
        <control type="label">
          <description>Rating</description>
          <width min="0" max="60">auto</width>
          <height>48</height>
          <font>infuse_meta</font>
          <textcolor>infuse_ink_dark</textcolor>
          <shadowcolor>00000000</shadowcolor>

<?xml version='1.0' encoding='utf-8'?>
<window id="1143" type="dialog">
  <defaultcontrol always="true">10</defaultcontrol>
  <!-- Freeze the purpose before playback can end; only settings may request reset. -->
  <onload condition="!Player.HasMedia + Window.IsVisible(skinsettings)">SetProperty(YoPlayer.ConfirmMode,reset,1143)</onload>
  <onload condition="Player.HasMedia | !Window.IsVisible(skinsettings)">SetProperty(YoPlayer.ConfirmMode,stop,1143)</onload>
  <onload condition="Skin.HasSetting(backstopplay) + [Player.Paused | Player.Playing]">stop</onload>
  <onload condition="Skin.HasSetting(backstopplay) + !Window.IsVisible(skinsettings)">Dialog.Close(1143)</onload>
  <onunload>ClearProperty(YoPlayer.ConfirmMode,1143)</onunload>
  <coordinates>
    <left>473</left>
    <top>330</top>
  </coordinates>
  <include>dialogeffect</include>
  <depth>DepthDialog+</depth>
  <controls>
    <control type="image">
      <description>background image</description>
      <left>0</left>
      <top>0</top>
      <width>975</width>
      <height>390</height>
      <texture border="32,32,32,32" colordiffuse="FFFFFFFF">infuse/glass_card_dark.png</texture>
    </control>
    <control type="image">
      <top>10</top>
      <left>820</left>
      <height>50</height>
      <width>128</width>
      <bordersize>0</bordersize>
      <aspectratio>keep</aspectratio>
      <texture>$VAR[skinlogoimage]</texture>
    </control>
    <control type="image">
      <top>70</top>
      <width>935</width>
      <height>1</height>
      <left>20</left>
      <texture colordiffuse="26FFFFFF">common/white.png</texture>
    </control>
    <control type="label">
      <width>935</width>
      <label>警告</label>
      <top>16</top>
      <left>20</left>
      <align>center</align>
      <font>infuse_section</font>
      <textcolor>infuse_ink_dark</textcolor>
    </control>
    <control type="textbox" id="9">
      <description>text</description>
      <left>45</left>
      <top>143</top>
      <width>885</width>
      <height>147</height>
      <align>center</align>
      <label>需要复位皮肤设置吗？(警告:所有皮肤设置将被恢复成初始值!)</label>
      <font>infuse_meta</font>
      <textcolor>red</textcolor>
      <visible>String.IsEqual(Window(1143).Property(YoPlayer.ConfirmMode),reset)</visible>
    </control>
    <control type="textbox" id="9">

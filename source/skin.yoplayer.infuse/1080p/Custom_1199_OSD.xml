<?xml version='1.0' encoding='utf-8'?>
<window type="dialog" id="1199">
  <defaultcontrol always="true">3001</defaultcontrol>
  <onload>SetFocus(3001)</onload>
  <controls>
    <control type="group">
      <include>Animation_SlideIn_Dialog</include>
      <depth>DepthMax</depth>
      <left>1580</left>
      <top>475</top>
      <width>340</width>
      <height>435</height>
      <control type="image">
        <texture border="16" colordiffuse="90282a2e">common/dialog.png</texture>
        <width>340</width>
        <height>535</height>
      </control>
      <control type="group">
        <height>80</height>
        <control type="label">
          <label>快捷菜单</label>
          <top>-20</top>
          <left>30</left>
          <textoffsetx>10</textoffsetx>
          <font>font13</font>
          <aligny>center</aligny>
          <textcolor>green</textcolor>
        </control>
        <control type="image">
          <top>50</top>
          <height>1</height>
          <left>20</left>
          <right>20</right>
          <texture colordiffuse="$INFO[Skin.String(customcolor)]">common/white.png</texture>
        </control>
      </control>
      <control type="list" id="3001">
        <top>70</top>
        <left>20</left>
        <width>300</width>
        <height>450</height>
        <orientation>vertical</orientation>
        <itemlayout height="50" width="300">
          <control type="group">
            <control type="image">
              <left>20</left>
              <top>10</top>
              <width>30</width>
              <height>30</height>
              <aspectratio>keep</aspectratio>
              <texture colordiffuse="white">$INFO[ListItem.Property(icon)]</texture>
            </control>
            <control type="label">
              <left>60</left>
              <height>50</height>
              <aligny>center</aligny>
              <font>font11</font>
              <textcolor>white</textcolor>
              <label>$INFO[ListItem.Label]</label>
            </control>
            <control type="image">
              <left>220</left>
              <top>10</top>
              <width>30</width>
              <height>30</height>
              <bordersize>2</bordersize>
              <aspectratio>keep</aspectratio>
              <texture colordiffuse="white">$INFO[ListItem.Property(iscurrent),common/check-on.png,common/check-off.png]</texture>
              <visible>!String.IsEmpty(ListItem.Property(iscurrent))</visible>
            </control>
            <control type="image">
              <left>260</left>
              <top>10</top>
              <width>30</width>
              <height>30</height>
              <aspectratio>keep</aspectratio>
              <texture colordiffuse="white">common/rightarrow.png</texture>
            </control>
          </control>
        </itemlayout>
        <focusedlayout height="50" width="300">
          <control type="group">
            <control type="image">
              <width>300</width>
              <height>50</height>
              <texture border="0,2,0,2" colordiffuse="$INFO[Skin.String(customcolor)]">$VAR[selectboxlist]</texture>
              <visible>Control.HasFocus(3001)</visible>
              <include>VisibleFadeEffect</include>
            </control>
            <control type="image">
              <left>20</left>
              <top>10</top>
              <width>30</width>
              <height>30</height>
              <aspectratio>keep</aspectratio>
              <texture colordiffuse="FFFF8C00">$INFO[ListItem.Property(icon)]</texture>
            </control>
            <control type="label">
              <left>60</left>
              <height>50</height>
              <aligny>center</aligny>
              <font>font11</font>
              <textcolor>$VAR[iconblack]</textcolor>
              <label>$INFO[ListItem.Label]</label>
            </control>
            <control type="image">
              <left>220</left>
              <top>10</top>
              <width>30</width>
              <height>30</height>
              <bordersize>2</bordersize>
              <aspectratio>keep</aspectratio>
              <texture colordiffuse="FFFF8C00">$INFO[ListItem.Property(iscurrent),common/check-on.png,common/check-off.png]</texture>
              <visible>!String.IsEmpty(ListItem.Property(iscurrent))</visible>
            </control>
            <control type="image">
              <left>260</left>
              <top>10</top>
              <width>30</width>
              <height>30</height>
              <aspectratio>keep</aspectratio>
              <texture colordiffuse="FFFF8C00">common/rightarrow.png</texture>
            </control>
          </control>
        </focusedlayout>
        <content>
          <item>
            <label>信息页</label>
            <property name="iscurrent">false</property>
            <property name="icon">icons/cpu.png</property>
            <onclick>Dialog.Close(1199)</onclick>
            <onclick>ActivateWindow(PlayerProcessInfo)</onclick>
          </item>
          <item>
            <label>字幕选择</label>
            <property name="iscurrent">false</property>
            <property name="icon">icons/jiema.png</property>
            <property name="action">activatewindow(1144)</property>
            <onclick>Dialog.Close(1199)</onclick>
            <onclick>activatewindow(1144)</onclick>
          </item>
          <item>
            <label>音轨选择</label>
            <property name="iscurrent">false</property>
            <property name="icon">icons/audio.png</property>
            <property name="action">activatewindow(1145)</property>
            <onclick>Dialog.Close(1199)</onclick>
            <onclick>activatewindow(1145)</onclick>
          </item>
          <item>
            <label>VS10模式</label>
            <property name="iscurrent">false</property>
            <property name="icon">icons/settings1.png</property>
            <property name="action">activatewindow(1116)</property>
            <onclick>Dialog.Close(1199)</onclick>
            <onclick>activatewindow(1116)</onclick>
          </item>
          <item>
            <label>剧集选择</label>
            <property name="iscurrent">false</property>
            <property name="icon">icons/tvshow1.png</property>
            <onclick>Dialog.Close(1199)</onclick>
            <onclick>activatewindow(1140)</onclick>
          </item>
          <item>
            <label>下一集</label>
            <property name="iscurrent">false</property>
            <property name="icon">OSDNextTrackNF.png</property>
            <onclick>Dialog.Close(1199)</onclick>
            <onclick>RunScript(special://skin/scripts/nextitem.py,next)</onclick>
          </item>
          <item>
            <label>上一集</label>
            <property name="iscurrent">false</property>
            <property name="icon">OSDPrevTrackNF.png</property>
            <onclick>Dialog.Close(1199)</onclick>
            <onclick>RunScript(special://skin/scripts/nextitem.py,Previous)</onclick>
          </item>
        </content>
      </control>
    </control>
  </controls>
</window>
        <control type="image">
          <left>18</left>
          <top>18</top>
          <width>36</width>
          <height>36</height>
          <texture colordiffuse="infuse_ink_light">$PARAM[icon]</texture>
          <visible>![$PARAM[dark]] + !Control.HasFocus($PARAM[id])</visible>
        </control>
        <control type="button" id="$PARAM[id]">
          <left>0</left>
          <top>0</top>
          <width>72</width>
          <height>72</height>
          <texturefocus>-</texturefocus>
          <texturenofocus>-</texturenofocus>
          <onclick>$PARAM[onclick]</onclick>
          <onleft>$PARAM[onleft]</onleft>
          <onright>$PARAM[onright]</onright>
          <onup>$PARAM[onup]</onup>
          <ondown>$PARAM[ondown]</ondown>
          <onback>$PARAM[onback]</onback>
          <onfocus>$PARAM[onfocus]</onfocus>
          <label />
          <pulseonselect>false</pulseonselect>
        </control>
      </control>
    </definition>
  </include>
  <include name="InfuseGenreTile">
    <param name="texture" default="infuse/genre_action.png" />
    <param name="label" default="$INFO[ListItem.Label]" />
    <param name="width" default="560" />
    <param name="height" default="238" />
    <param name="textcolor" default="FFFFFFFF" />
    <definition>
      <control type="group">
        <left>0</left>
        <top>8</top>
        <width>$PARAM[width]</width>
        <height>$PARAM[height]</height>
        <animation effect="zoom" start="100" end="106" center="auto" time="120" tween="sine" easing="out">Focus</animation>
        <animation effect="zoom" start="106" end="100" center="auto" time="120" tween="sine" easing="out">UnFocus</animation>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>$PARAM[height]</height>
          <texture>$PARAM[texture]</texture>
        </control>
        <control type="image" description="YoPlayer genre art">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>$PARAM[height]</height>
          <texture diffuse="infuse/genre50/mask.png" background="true" fallback="infuse/genre50/transparent.png">$INFO[ListItem.Art(fanart)]</texture>
          <aspectratio scalediffuse="false">scale</aspectratio>
        </control>
        <control type="image" description="YoPlayer genre tint">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>$PARAM[height]</height>
          <texture colordiffuse="A8FFFFFF">$PARAM[texture]</texture>
        </control>
        <control type="image" description="YoPlayer genre shade">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>$PARAM[height]</height>
          <texture diffuse="infuse/genre50/mask.png" colordiffuse="38000000">common/white.png</texture>
        </control>
        <control type="label">
          <left>36</left>
          <top>0</top>
          <width>488</width>
          <height>$PARAM[height]</height>
          <font>infuse_section</font>
          <textcolor>$PARAM[textcolor]</textcolor>
          <label>$PARAM[label]</label>
          <align>center</align>
          <aligny>center</aligny>
          <scroll>true</scroll>
          <shadowcolor>88001E42</shadowcolor>
        </control>
      </control>
    </definition>
    <param name="focused" default="false" />
  </include>
  <include name="InfuseMetaLine">
    <param name="left" default="0" />
    <param name="top" default="0" />
    <param name="width" default="1800" />
    <definition>
      <control type="grouplist">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>56</height>
        <orientation>horizontal</orientation>
        <itemgap>12</itemgap>
        <align>left</align>
        <control type="image">
          <top>14</top>
          <width>28</width>
          <height>28</height>
          <texture colordiffuse="infuse_ink_dark">infuse/icons/star_fill.png</texture>
          <visible>!Skin.HasSetting(YoPlayerHideRating) + !String.IsEmpty(ListItem.Property(YoPlayer.Rating))</visible>
        </control>
        <control type="label">
          <width>65</width>
          <height>56</height>
          <font>infuse_meta</font>
          <textcolor>infuse_ink_dark</textcolor>
          <label>$INFO[ListItem.Property(YoPlayer.Rating)]</label>
          <align>left</align>
          <aligny>center</aligny>
          <visible>!Skin.HasSetting(YoPlayerHideRating) + !String.IsEmpty(ListItem.Property(YoPlayer.Rating))</visible>
        </control>
        <control type="label">
          <width>130</width>
          <height>56</height>
          <font>infuse_meta</font>
          <textcolor>infuse_ink_dark</textcolor>
          <label>$INFO[ListItem.Duration]</label>
          <align>left</align>
          <aligny>center</aligny>
          <visible>!String.IsEmpty(ListItem.Duration)</visible>
        </control>
        <control type="label">
          <width>70</width>
          <height>56</height>
          <font>infuse_meta</font>
          <textcolor>infuse_ink_dark</textcolor>
          <label>$INFO[ListItem.Year]</label>
          <align>left</align>
          <aligny>center</aligny>
          <visible>!String.IsEmpty(ListItem.Year)</visible>
        </control>
        <control type="group">
          <width>160</width>
          <height>56</height>
          <visible>!String.IsEmpty(ListItem.Mpaa)</visible>
          <control type="image">
            <left>0</left>
            <top>4</top>
            <width>160</width>
            <height>48</height>
            <texture border="12,12,12,12">infuse/badge_outline.png</texture>
          </control>
          <control type="label">
            <left>0</left>
            <top>4</top>
            <width>160</width>
            <height>48</height>
            <font>infuse_card_sub</font>
            <textcolor>infuse_ink_dark</textcolor>
            <label>$INFO[ListItem.Mpaa]</label>
            <align>center</align>
            <aligny>center</aligny>
          </control>
        </control>
        <control type="label">
          <top>0</top>
          <width>50</width>
          <height>56</height>
          <visible>[String.IsEqual(ListItem.VideoResolution,4K) | String.IsEqual(ListItem.VideoResolution,2160) | String.IsEqual(ListItem.VideoResolution,8K)]</visible>
          <font>infuse_meta</font>
          <textcolor>infuse_ink_dark</textcolor>
          <aligny>center</aligny>
          <label>4K</label>
        </control>
        <control type="label">
          <top>0</top>
          <width>50</width>
          <height>56</height>
          <visible>String.IsEqual(ListItem.HdrType,dolbyvision)</visible>
          <font>infuse_meta</font>
          <textcolor>infuse_ink_dark</textcolor>
          <aligny>center</aligny>
          <label>DV</label>
        </control>
        <control type="label">
          <top>0</top>
          <height>56</height>

    <onstop>Dialog.Close(1121)</onstop>
  </timer>
  <timer>
    <name>1122autoclose</name>
    <start reset="true">Window.IsActive(1122)</start>
    <reset>Window.IsActive(1122) + !System.IdleTime(1) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(1122autoclose), 1)</reset>
    <stop>Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(1122autoclose), 4)</stop>
